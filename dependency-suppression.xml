    <suppress until="2026-12-31">
        <notes><![CDATA[
   file name: jline-*-3.24.1.jar (bundled inside kotlin-compiler / Kotlin build tooling)
   CVE-2023-50572 (JLine terminal) and CVE-2026-56740 / CVE-2026-56741 (JLine Telnet server,
   jline-remote-telnet) are build-time toolchain only, never shipped to clients. The project
   declares no jline dependency of its own and runs no Telnet server.
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jline/.*@.*$</packageUrl>
        <cve>CVE-2023-50572</cve>
        <cve>CVE-2026-56740</cve>
        <cve>CVE-2026-56741</cve>
    </suppress>
