    <suppress until="2026-12-31">
        <notes><![CDATA[
   file name: kotlin-*.jar
   Kotlin build-tooling CVEs. CVE-2020-29582 affects createTempFile/createTempDir in
   kotlin-stdlib only; CVE-2026-53914 is unsafe deserialization of build-cache metadata in the
   Kotlin compiler / build tooling. Neither is reachable from the kotlin-stdlib shipped in the APK.
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/.*@.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
        <cve>CVE-2026-53914</cve>
