    <suppress until="2026-12-31">
        <notes><![CDATA[
   file name: browser-*.aar
   False positive: androidx.browser is the AndroidX Custom Tabs / Trusted Web Activities support
   library. CVE-2008-7298 affects the deprecated AOSP stock Browser app, which is unrelated to this
   library. The CPE collision is purely a name match on "android" + "browser".
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/androidx\.browser/browser@.*$</packageUrl>
        <cve>CVE-2008-7298</cve>
    </suppress>
